{
  "name": "voxelcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A voxel sandbox game (Minecraft-like) built with TypeScript and three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:economy": "node scripts/smoke.mjs http://localhost:5173/ screenshots --economy",
    "smoke:vehicles": "node scripts/vehicle-smoke.mjs",
    "smoke:town": "node scripts/town-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
